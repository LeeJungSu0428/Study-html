<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<style>
  body { font-family: sans-serif; text-align: center; padding-top: 80px; }
  button { font-size: 20px; padding: 12px 24px; cursor: pointer; }
  h1 { font-size: 48px; }
</style>
</head>
<body>

  <!-- ① HTML: 그냥 화면에 보이는 것들. 여기까진 이미 알고 계신 부분 -->
  <h1 id="count-display">0</h1>
  <button id="my-button">누르면 +1</button>

  <script>
    // ② JS: HTML 요소를 "찾아서" 붙잡기
    //   document.getElementById("아이디") = HTML에서 그 id를 가진 태그를 찾아옴
    const display = document.getElementById("count-display"); // <h1>을 붙잡음
    const button = document.getElementById("my-button");       // <button>을 붙잡음

    // ③ 이 숫자를 "기억"할 변수. HTML은 아무것도 기억 못 하니 JS가 대신 기억해줌
    let count = 0;

    // ④ "이 버튼이 클릭되면, 이 함수를 실행해라"라고 브라우저에게 등록
    button.addEventListener("click", function () {
      count = count + 1;              // 기억하던 숫자를 1 늘림
      display.textContent = count;    // 화면의 <h1> 글자를 그 숫자로 직접 덮어씀
    });
  </script>

</body>
</html>




import { useState } from "react";

export default function Counter() {
  // ① "기억"할 값을 선언. count = 지금 값, setCount = 이 값을 바꾸는 전용 함수
  const [count, setCount] = useState(0);

  // ② 버튼 클릭되면 실행될 함수. "화면을 직접 안 건드리고" 값만 바꿈
  function handleClick() {
    setCount(count + 1);
  }

  // ③ 화면 자체가 "지금 count 값"을 그대로 보여주도록 되어있음
  return (
    <div style={{ textAlign: "center", paddingTop: "80px", fontFamily: "sans-serif" }}>
      <h1 style={{ fontSize: "48px" }}>{count}</h1>
      <button
        onClick={handleClick}
        style={{ fontSize: "20px", padding: "12px 24px", cursor: "pointer" }}
      >
        누르면 +1
      </button>
    </div>
  );
}


// Main 에서 <Counter /> 하면 Counter 호출






